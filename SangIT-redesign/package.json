{
    "name":  "sonora",
    "private":  true,
    "version":  "0.1.0",
    "engines":  {
                    "node":  "\u003e=20"
                },
    "workspaces":  [
                       "server",
                       "web"
                   ],
    "scripts":  {
                    "dev":  "concurrently -n api,web -c blue,green \"npm run dev -w server\" \"npm run dev -w web\"",
                    "typecheck":  "npm run typecheck -w server \u0026\u0026 npm run typecheck -w web",
                    "build":  "npm run build -w web",
                    "scan-music":  "node scripts/scan-music.mjs"
                },
    "devDependencies":  {
                            "concurrently":  "^9.1.0",
                            "music-metadata":  "^10.6.0",
                            "typescript":  "^5.7.2"
                        }
}
